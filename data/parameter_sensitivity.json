  "schema_version": 1,
  "scope": {
    "answers": "which unmeasured parameter moves the expected score most",
    "covers": "the ten costable placement missions; the two cables are still nominal_pending, so the ceiling here is 225 and never 255",
    "does_not_answer": "what the score will be. Every figure is an evaluation at an ASSUMED operating point, not a forecast - all six parameters are unmeasured",
    "one_at_a_time": "Each swing varies ONE parameter with the others at the context nominal, so interactions are invisible within a context. That is why two contexts are published rather than one - the interaction between sigma, speed and handling time is the whole finding.",
    "reachable_max": 225,
    "why_not_255": "40 bonus floor + 185 costable placement points. The two cables add 30 more, and no route through them can be costed until work order B0."
  }
