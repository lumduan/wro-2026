# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# --- Third-party source documents: NOT redistributed ---
# S1/S2/S3 are (c) 2026 World Robot Olympiad Association Ltd. This repository
# publishes the toolchain and our own analysis, not WRO's documents. Download
# them yourself from the WRO site into docs/ -- README.md lists the expected
# filenames and sha256s, and pdf_extract.py records the hash of whatever it
# actually read, so a substituted file is detectable.
docs/*.pdf

# S6 (official Q&A) snapshots are third-party content for the same reason.
# docs/s6_index.json IS committed -- it carries the per-answer timestamp tuples
# that change detection diffs on, without redistributing the answers.
docs/s6-qa-snapshot-*.html

# Text extractions reproduce the rulebook verbatim, so they are local-only for
# the same reason. Regenerate with:  uv run python tools/pdf_extract.py all <pdf>
docs/extracted/**/text/
docs/extracted/WRO-2026-GameMat-Elementary-Printing-File/WRO-2026-GameMat-Elementary-Printing-File.md
docs/extracted/WRO-2026-RM-Elementary-BI-All/WRO-2026-RM-Elementary-BI-All.md
docs/extracted/WRO-2026-RoboMission-Elementary-Game-Rules/WRO-2026-RoboMission-Elementary-Game-Rules.md

# --- Generated extraction artifacts ---
# Rasters are large and fully regenerable from the source PDFs via
# `tools/pdf_extract.py`; manifest.json records a sha256 for every one of them,
# so integrity stays auditable without committing the bytes. See DECISIONS.md ADR-001.
docs/extracted/**/render/
docs/extracted/**/img/

# The S2 vector dump is ~120 MB of JSON for a single page (55k paths, 275k
# Beziers). Git stores every revision whole, so committing it would add that
# much to history on each regeneration. fills_by_colour.json IS committed --
# it is the raw inventory the extraction report presents. See ADR-010.
docs/extracted/**/vector/drawings.json

# Git has no size-based ignore rule. The ">5 MB PNG" constraint is enforced
# structurally instead: every PNG this toolchain emits lands in either render/
# or img/, both of which are ignored above. If a PNG ever appears outside those
# two directories, that is a bug in the tool, not something to paper over here.
*.tmp
scratch/
archive/
